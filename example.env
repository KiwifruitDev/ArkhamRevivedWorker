# Secret used to HMAC player ids into deterministic UUIDs
UUID_HASH=

# Full URL of the Discord bot webhook, e.g. https://bot.example.com/webhook
WEBHOOK_URL=

# Shared secret sent as the x-webhook-secret header (must match the bot's WEBHOOK_SECRET)
WEBHOOK_SECRET=

